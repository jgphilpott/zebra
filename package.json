{
  "name": "zebra",
  "version": "1.0.0",
  "description": "A dating app for black and white couples",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/mobile",
    "packages/web"
  ],
  "scripts": {
    "mobile": "cd packages/mobile && npm start",
    "web": "cd packages/web && npm run dev",
    "shared": "cd packages/shared && npm run build",
    "install-all": "npm install && npm run install-packages",
    "install-packages": "cd packages/shared && npm install && cd ../mobile && npm install && cd ../web && npm install"
  },
  "keywords": [
    "dating",
    "react-native",
    "next.js",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
